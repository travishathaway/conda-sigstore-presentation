{
	"name": "conda-revealjs-starter-kit",
	"private": true,
	"version": "1.0.0",
	"description": "Starter kit for creating conda themed reveal.js presentations",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "npm run dev",
		"build": "vite build",
		"mmdc": "mmdc",
		"render:sigstore-process": "mmdc -i sigstore-process.mmd -o assets/sigstore-process.svg -c mermaid-theme.json -b transparent"
	},
	"dependencies": {
		"reveal.js": "^6.0.1",
		"reveal.js-conda-theme": "^2.0.0"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^11.17.0",
		"vite": "^8.0.16"
	}
}
